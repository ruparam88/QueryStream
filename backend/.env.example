# =============================================================================
# QueryStream — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables have defaults except GEMINI_API_KEY (required for queries).
# Environment variables set in the shell always override this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini (REQUIRED for query execution)
# -----------------------------------------------------------------------------

# Your Google AI Studio or Vertex AI API key.
GEMINI_API_KEY=

# Gemini model used for structured query generation.
# Defaults: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Gemini model used for semantic cache embeddings.
# Defaults: gemini-embedding-2
GEMINI_EMBED_MODEL=gemini-embedding-2

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL. Supports plain (redis://) and TLS (rediss://) URIs.
# Cloud examples:
#   redis://:password@your-redis.upstash.io:6379
#   rediss://default:password@your-redis.upstash.io:6379
REDIS_URL=redis://localhost:6379

# How long session data is kept in Redis (seconds). Default: 3600 (1 hour).
SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Semantic Cache
# -----------------------------------------------------------------------------

# Cosine similarity threshold for a cache hit. Range: 0.0–1.0.
# Higher = stricter matching (fewer hits, more accurate).
# Lower  = looser matching (more hits, potentially stale results).
# Default: 0.95
SEM_CACHE_THRESHOLD=0.95

# How long semantic cache entries are kept in Redis (seconds).
# Default: 86400 (24 hours).
CACHE_TTL_SECONDS=86400

# Maximum number of entries per (session_id, db_type) cache list.
# Oldest entries are dropped when this limit is reached (LIFO trim).
# Default: 200
CACHE_MAX_ENTRIES=200

# -----------------------------------------------------------------------------
# Self-Healing Query Graph
# -----------------------------------------------------------------------------

# Maximum LLM + DB execution attempts before escalating to the user.
# Default: 3
MAX_QUERY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Application Server
# -----------------------------------------------------------------------------

# Uvicorn bind host. Use 0.0.0.0 for Docker / production.
APP_HOST=0.0.0.0

# Uvicorn bind port.
APP_PORT=8000

# Enable debug mode (auto-reload, verbose output). Set false in production.
DEBUG=false

# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated). Use * for development only.
# Production example: https://querystream.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*
